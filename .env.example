# Copy to .env and fill in. .env is git-ignored — never commit real keys.

# Penpot MCP key: design.penpot.app → Your account → Integrations → MCP Server.
# Paste only the key (the part after "userToken="), not the whole URL.
PENPOT_MCP_KEY=

# Optional: self-hosted Penpot base URL (defaults to https://design.penpot.app).
# PENPOT_BASE_URL=https://design.penpot.app
